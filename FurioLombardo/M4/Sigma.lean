import FurioLombardo.M4.Checks

/-!
# The localisation `σ_v` of the Selmer group is injective (step (K2))

Abstract form: a group `Sel` killed by 2 and generated by `g_1, ..., g_4` (the generators of `Sel²(A/k)`, (K1)),
a homomorphism `σ : Sel → H` (in the application `H = A(k_v)/2A(k_v)` or the local `x - T` image) sending `g_j` to
`∑_i SB i j d_i`, where `d_1, ..., d_7` are independent modulo 2 (the classes of the local divisors `D_1, ..., D_7`,
a basis of `A(k_v)/2A(k_v)`, (L2)). If `SB` has a left inverse modulo 2, `σ` is injective. The left inverses are
kernel checked in `FurioLombardo.M4.T0.hSBL` and `FurioLombardo.M4.T1.hSBL`.
-/

namespace FurioLombardo.M4

/-- `σ` is injective when the matrix of the images of the generators in an independent family has a left inverse
modulo 2. -/
theorem sigma_injective {Sel H : Type*} [AddCommGroup Sel] [AddCommGroup H] (σ : Sel →+ H)
    (g : Fin 4 → Sel) (d : Fin 7 → H) (SB : Matrix (Fin 7) (Fin 4) ℤ) (L : Matrix (Fin 4) (Fin 7) ℤ)
    (h2 : ∀ s : Sel, (2 : ℕ) • s = 0)
    (hgen : ∀ s : Sel, ∃ e : Fin 4 → ℤ, s = ∑ j, e j • g j)
    (hσ : ∀ j, σ (g j) = ∑ i, SB i j • d i)
    (hind : ∀ c : Fin 7 → ℤ, ∑ i, c i • d i = 0 → ∀ i, (2 : ℤ) ∣ c i)
    (hL : ∀ a b : Fin 4, (2 : ℤ) ∣ (L * SB) a b - if a = b then 1 else 0) :
    ∀ s, σ s = 0 → s = 0 := by
  intro s hs
  obtain ⟨e, rfl⟩ := hgen s
  -- the image is the combination of the `d_i` with coefficients `SB e`
  have himg : σ (∑ j, e j • g j) = ∑ i, (SB.mulVec e) i • d i := by
    simp only [map_sum, map_zsmul, hσ, Finset.smul_sum, smul_smul, Matrix.mulVec, dotProduct]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [Finset.sum_smul]
    exact Finset.sum_congr rfl (fun j _ => by rw [mul_comm])
  have hdiv : ∀ i, (2 : ℤ) ∣ (SB.mulVec e) i := hind _ (by rw [← himg]; exact hs)
  have he : ∀ a, (2 : ℤ) ∣ e a := by
    intro a
    have h1 : (2 : ℤ) ∣ (L.mulVec (SB.mulVec e)) a := by
      simp only [Matrix.mulVec, dotProduct]
      exact Finset.dvd_sum (fun i _ => Dvd.dvd.mul_left (hdiv i) _)
    rw [Matrix.mulVec_mulVec] at h1
    have h3 : (2 : ℤ) ∣ ((L * SB).mulVec e) a - e a := by
      have : ((L * SB).mulVec e) a - e a = ∑ b, ((L * SB) a b - if a = b then 1 else 0) * e b := by
        simp only [Matrix.mulVec, dotProduct, sub_mul, Finset.sum_sub_distrib, ite_mul, one_mul, zero_mul,
          Finset.sum_ite_eq, Finset.mem_univ, ite_true]
      rw [this]
      exact Finset.dvd_sum (fun b _ => Dvd.dvd.mul_right (hL a b) _)
    have := dvd_sub h1 h3
    rwa [sub_sub_cancel] at this
  have hz : ∀ j, e j • g j = 0 := by
    intro j
    obtain ⟨k, hk⟩ := he j
    have h2z : (2 : ℤ) • g j = 0 := by rw [show (2 : ℤ) = ((2 : ℕ) : ℤ) by norm_num, natCast_zsmul, h2]
    rw [hk, mul_comm, mul_zsmul, h2z, zsmul_zero]
  simp [hz]

/-- (K2) for the twist δ0: `σ_v` is injective given (K1) (four generators) and (L2) (independence of the `D_i`). -/
theorem T0.sigma_injective {Sel H : Type*} [AddCommGroup Sel] [AddCommGroup H] (σ : Sel →+ H)
    (g : Fin 4 → Sel) (d : Fin 7 → H) (h2 : ∀ s : Sel, (2 : ℕ) • s = 0)
    (hgen : ∀ s : Sel, ∃ e : Fin 4 → ℤ, s = ∑ j, e j • g j)
    (hσ : ∀ j, σ (g j) = ∑ i, T0.SB i j • d i)
    (hind : ∀ c : Fin 7 → ℤ, ∑ i, c i • d i = 0 → ∀ i, (2 : ℤ) ∣ c i) : ∀ s, σ s = 0 → s = 0 :=
  FurioLombardo.M4.sigma_injective σ g d T0.SB T0.SBL h2 hgen hσ hind T0.hSBL

/-- (K2) for the twist δ1. -/
theorem T1.sigma_injective {Sel H : Type*} [AddCommGroup Sel] [AddCommGroup H] (σ : Sel →+ H)
    (g : Fin 4 → Sel) (d : Fin 7 → H) (h2 : ∀ s : Sel, (2 : ℕ) • s = 0)
    (hgen : ∀ s : Sel, ∃ e : Fin 4 → ℤ, s = ∑ j, e j • g j)
    (hσ : ∀ j, σ (g j) = ∑ i, T1.SB i j • d i)
    (hind : ∀ c : Fin 7 → ℤ, ∑ i, c i • d i = 0 → ∀ i, (2 : ℤ) ∣ c i) : ∀ s, σ s = 0 → s = 0 :=
  FurioLombardo.M4.sigma_injective σ g d T1.SB T1.SBL h2 hgen hσ hind T1.hSBL

end FurioLombardo.M4

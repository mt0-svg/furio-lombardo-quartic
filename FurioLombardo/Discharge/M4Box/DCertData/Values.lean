theorem K0I0.cert (j : Fin 2) :
    ‖lamK 0 (SelmerSpan.Dpt 0 0) j‖ ≤ 1 ∧
      ‖lamK 0 (SelmerSpan.Dpt 0 0) j - evZ (lTriple (FurioLombardo.M4.T0.lD 0) j)‖ ≤ ‖pv‖ ^ (3 * FurioLombardo.M4.T0.qD 0) :=
  lamK_Dpt_of_cert 0 0 dCtx_ok Tw0.hF Tw0.hg Tw0.hb Tw0.hE Tw0.hA hD hR hfin j


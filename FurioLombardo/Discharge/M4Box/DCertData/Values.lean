theorem fin7_cases (i : Fin 7) : i = 0 ∨ i = 1 ∨ i = 2 ∨ i = 3 ∨ i = 4 ∨ i = 5 ∨ i = 6 := by
  revert i; decide

theorem lamK_Dpt_le_one_0 (i : Fin 7) (j : Fin 2) : ‖lamK 0 (SelmerSpan.Dpt 0 i) j‖ ≤ 1 := by
  obtain rfl | rfl | rfl | rfl | rfl | rfl | rfl := fin7_cases i
  exacts [(K0I0.cert j).1, (K0I1.cert j).1, (K0I2.cert j).1, (K0I3.cert j).1, (K0I4.cert j).1, (K0I5.cert j).1, (K0I6.cert j).1]

theorem lamK_Dpt_sub_0 (i : Fin 7) (j : Fin 2) :
    ‖lamK 0 (SelmerSpan.Dpt 0 i) j - evZ (lTriple (FurioLombardo.M4.T0.data.lD i) j)‖ ≤ ‖pv‖ ^ (3 * FurioLombardo.M4.T0.data.qD i) := by
  obtain rfl | rfl | rfl | rfl | rfl | rfl | rfl := fin7_cases i
  exacts [(K0I0.cert j).2, (K0I1.cert j).2, (K0I2.cert j).2, (K0I3.cert j).2, (K0I4.cert j).2, (K0I5.cert j).2, (K0I6.cert j).2]

theorem lamK_Dpt_le_one_1 (i : Fin 7) (j : Fin 2) : ‖lamK 1 (SelmerSpan.Dpt 1 i) j‖ ≤ 1 := by
  obtain rfl | rfl | rfl | rfl | rfl | rfl | rfl := fin7_cases i
  exacts [(K1I0.cert j).1, (K1I1.cert j).1, (K1I2.cert j).1, (K1I3.cert j).1, (K1I4.cert j).1, (K1I5.cert j).1, (K1I6.cert j).1]

theorem lamK_Dpt_sub_1 (i : Fin 7) (j : Fin 2) :
    ‖lamK 1 (SelmerSpan.Dpt 1 i) j - evZ (lTriple (FurioLombardo.M4.T1.data.lD i) j)‖ ≤ ‖pv‖ ^ (3 * FurioLombardo.M4.T1.data.qD i) := by
  obtain rfl | rfl | rfl | rfl | rfl | rfl | rfl := fin7_cases i
  exacts [(K1I0.cert j).2, (K1I1.cert j).2, (K1I2.cert j).2, (K1I3.cert j).2, (K1I4.cert j).2, (K1I5.cert j).2, (K1I6.cert j).2]

theorem lamK_Dpt_le_one (k : Fin 2) (i : Fin 7) (j : Fin 2) : ‖lamK k (SelmerSpan.Dpt k i) j‖ ≤ 1 := by
  obtain rfl | rfl : k = 0 ∨ k = 1 := by revert k; decide
  · exact lamK_Dpt_le_one_0 i j
  · exact lamK_Dpt_le_one_1 i j

/-- **`ChartLog` for lane M4's logarithm**, both twists. -/
theorem chartLog (k : Fin 2) : FurioLombardo.Discharge.R7.ChartLog k (lam k) :=
  chartLog_of_values k (lamK_Dpt_le_one k)

/-- **The balls of the D_i logarithms** (`hBD` of `M4RestKvW`), twist 0. -/
theorem hBD_0 : FurioLombardo.M4.HBallD FurioLombardo.M4.T0.data (fun i => lam 0 (SelmerSpan.Dpt 0 i)) :=
  hBallD_of_values 0 FurioLombardo.M4.T0.data (lamInt_of 0 (lamK_Dpt_le_one 0)) lamK_Dpt_sub_0

/-- **The balls of the D_i logarithms** (`hBD` of `M4RestKvW`), twist 1. -/
theorem hBD_1 : FurioLombardo.M4.HBallD FurioLombardo.M4.T1.data (fun i => lam 1 (SelmerSpan.Dpt 1 i)) :=
  hBallD_of_values 1 FurioLombardo.M4.T1.data (lamInt_of 1 (lamK_Dpt_le_one 1)) lamK_Dpt_sub_1


// Step 2 of the 2-descent: the plane model of C is smooth over Z[1/14].
// For p odd, a point of C mod p is singular iff it is a common zero of Fx, Fy, Fz (Euler: 4F = x Fx + y Fy + z Fz).
// We find integers N_v and integral polynomials with N_v * v^7 = b1 Fx + b2 Fy + b3 Fz for v = x, y, z.
// Then for p odd, p not dividing N_x N_y N_z, the partials have no common zero in P^2(F_p-bar): C has good reduction.
// Remaining odd primes p != 7 dividing some N_v are checked directly over F_p (Krull dimension of <Fx,Fy,Fz> equals 0).
// Run: Singular -q good_reduction.sing < /dev/null
ring r = 0, (x,y,z), dp;
poly F = x^4 + 3*x^3*y - 3*x^2*y*z - 3*x^2*z^2 + 6*x*y^3 - 6*x*y^2*z + 3*x*y*z^2 - 2*x*z^3 + 4*y^4 + 2*y^3*z - 5*y*z^3;
ideal I = diff(F,x), diff(F,y), diff(F,z);
list bad;
int i; int j; int k;
poly v; matrix L; poly chkp; number N; number c;
for (i = 1; i <= 3; i++) {
  v = var(i)^7;
  L = lift(I, v);
  // common denominator of all coefficients of the cofactors
  N = 1;
  for (j = 1; j <= 3; j++) {
    poly q = L[j,1];
    while (q != 0) { c = leadcoef(q); N = N * denominator(c) / gcd(N, denominator(c)); q = q - lead(q); }
    kill q;
  }
  // check the identity N v = sum (N L_j) I_j with integral cofactors
  chkp = N*v - (N*L[1,1]*I[1] + N*L[2,1]*I[2] + N*L[3,1]*I[3]);
  print("variable " + string(var(i)) + ": N = " + string(N) + ", identity holds: " + string(chkp == 0));
  bad = insert(bad, N);
}
// factor the N-s completely (primefactors returns [primes, exponents, cofactor]; the cofactor must be 1)
LIB "general.lib";
list pf;
for (i = 1; i <= size(bad); i++) {
  pf = primefactors(bad[i]);
  print("N = " + string(bad[i]) + ": primes " + string(pf[1]) + ", exponents " + string(pf[2]) + ", unfactored cofactor " + string(pf[3]));
}
// direct check at the odd primes p != 7 dividing some N: Krull dimension of <Fx,Fy,Fz> over F_p is 0
list ps = 3, 5, 11, 13, 23, 37;
for (i = 1; i <= size(ps); i++) {
  execute("ring rp = " + string(ps[i]) + ", (x,y,z), dp;");
  poly Fp = imap(r, F);
  ideal Ip = diff(Fp,x), diff(Fp,y), diff(Fp,z);
  print("p = " + string(ps[i]) + ": dim <Fx,Fy,Fz> = " + string(dim(std(Ip))) + " (0 means C is smooth mod p)");
  setring r; kill rp;
}
// for information: the plane model at 2 and 7
ring r7 = 7, (x,y,z), dp; poly F7 = imap(r, F); ideal I7 = diff(F7,x), diff(F7,y), diff(F7,z), F7;
print("p = 7: dim <F,Fx,Fy,Fz> = " + string(dim(std(I7))));
ring r2 = 2, (x,y,z), dp; poly F2 = imap(r, F); ideal I2 = diff(F2,x), diff(F2,y), diff(F2,z), F2;
print("p = 2: dim <F,Fx,Fy,Fz> = " + string(dim(std(I2))));
quit;

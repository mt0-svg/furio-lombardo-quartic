\\ parities of the c-coordinates (U G l / 4) of la, lb in rows 0 and 1, both twists (data of lean/FurioLombardo/M4/Data.lean)
UG0 = [1, 0, -1, -1, -1, 0; 0, 1, 0, -1, 0, 0];
la0 = [51929924942636, 84297061864868, 46619155793640, 32360687822816, 49234586401224, 72827099206136]~;
lb0 = [129333689735212, 45638519686148, 50254955266536, 98783997883648, 95758583499128, 43041108216552]~;
UG1 = [0, 1, 0, -1, 0, 0; 0, 0, 2, 0, 0, 0];
la1 = [4308966666899728, 1216305662821968, 12246978068400512, 14351728238255276, 6507623262187084, 13047569246161404]~;
lb1 = [2026347536693064, 1237106922463536, 1991473550264600, 1276862928125268, 2584351291693156, 1418157200078092]~;
{
for (k = 0, 1,
  my(U = if(k, UG1, UG0), a = if(k, la1, la0), b = if(k, lb1, lb0), A = U*a, B = U*b);
  print("twist ", k, ": UG la rows 0,1 = ", A, " valuations ", [valuation(A[1],2), valuation(A[2],2)]);
  print("   UG lb rows 0,1 = ", B, " valuations ", [valuation(B[1],2), valuation(B[2],2)]);
  print("   det = ", A[1]*B[2]-A[2]*B[1], " val ", valuation(A[1]*B[2]-A[2]*B[1],2)));
}

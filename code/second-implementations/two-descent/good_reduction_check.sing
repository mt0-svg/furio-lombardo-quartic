// good_reduction_check.sing: referee check that the plane model of C is smooth over Z[1/14].
// Independent method: saturate I = (F, dF/dx, dF/dy, dF/dz) over the integers with respect to (x, y, z) and read off the
// integer N with (I : (x,y,z)^oo) n Z = (N): a prime p gives a singular point of the reduction mod p iff p | N
// (projective elimination); F is included in I so that p = 2 is also covered (Euler's identity fails there).
// Run: Singular -q good_reduction_check.sing
LIB "elim.lib";
ring r = integer, (x,y,z), dp;
poly F = x^4+3*x^3*y-3*x^2*y*z-3*x^2*z^2+6*x*y^3-6*x*y^2*z+3*x*y*z^2-2*x*z^3+4*y^4+2*y^3*z-5*y*z^3;
ideal I = F, diff(F,x), diff(F,y), diff(F,z);
def rs = sat(I, maxideal(1));
ideal S;
if (typeof(rs) == "list") { S = rs[1]; } else { S = rs; }
S = std(S);
print("saturated ideal, standard basis:");
print(S);
int i; bigint N = 0;
for (i = 1; i <= ncols(S); i++) { if (deg(S[i]) == 0) { N = bigint(leadcoef(S[i])); } }
print("N = ");
print(N);
// direct membership check: N v^k in I over Z for v = x, y, z (strong standard basis over the integers)
ideal GI = std(I);
int k; int kk;
for (kk = 1; kk <= 3; kk++) { for (k = 1; k <= 12; k++) { if (reduce(N * var(kk)^k, GI) == 0) { print("N * " + string(var(kk)) + "^" + string(k) + " lies in I"); break; } } }
// so for p not dividing N the reductions of x, y, z are nilpotent modulo I: no point of P^2(Fpbar) is singular on C mod p
quit;

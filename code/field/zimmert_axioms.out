@Zimmert.zimmert_satz2_half : ∀ {K : Type u_1} [inst : Field K] [inst_1 : NumberField K]
  (C : ClassGroup (NumberField.RingOfIntegers K)) {α : ℝ},
  0 < α →
    α < 1 / 2 →
      ∃ I,
        ClassGroup.mk0 I = C ∧
          zimmertS2 (NumberField.InfinitePlace.nrRealPlaces K) (NumberField.InfinitePlace.nrComplexPlaces K) (1 / 2) α ≤
            Real.log (√|↑(NumberField.discr K)| / ↑(Ideal.absNorm ↑I))
def FurioLombardo.M2.ZimmertSatz2K21 : Prop :=
∀ (C : ClassGroup (NumberField.RingOfIntegers K21)),
  ∃ I,
    ClassGroup.mk0 I = C ∧
      zimmertS2 (NumberField.InfinitePlace.nrRealPlaces K21) (NumberField.InfinitePlace.nrComplexPlaces K21) (1 / 2)
          (1 / 12) ≤
        Real.log (√|↑(NumberField.discr K21)| / ↑(Ideal.absNorm ↑I))

def shiftD (j : ℕ) (r : List ℤ) : List ℤ := List.replicate j 0 ++ r
def addT : List (List ℤ) → List (List ℤ) → List (List ℤ)
  | [], m => m
  | l, [] => l
  | r :: l, s :: m => addL r s :: addT l m
def dpStep (j : ℕ) (c : List (List ℤ)) : List (List ℤ) := addT c ([] :: c.map (shiftD j))
def tab (S : List ℕ) : List (List ℤ) := S.foldr dpStep [[1]]
def selJ (a : ℕ) : List ℕ := (List.range 12).filter fun j => a.testBit (j + 1)
def eNs (a : ℕ) : List (List ℤ) := (tab (selJ a)).map fun row => combo row w3alPow
def Yp (n : ℕ) : List ℤ × List ℤ := w3Ypow.getD n ([], [])
def alP (d : ℕ) : List ℤ := w3alPow.getD d []
def prj (i : ℕ) (p : List ℤ × List ℤ) : List ℤ := if i = 0 then p.1 else p.2
def X0E (z0 z1 : List ℤ) : KE := .add (.lin z0) (.mul (.lin z1) (.lin w3yL))
def X1E (z1 : List ℤ) : KE := .mul (.lin z1) (.lin (alP 5))
def lhsE (i : ℕ) (z0 z1 : List ℤ) (c : WCert) : KE :=
  let a0 := if c.a.testBit 0 then 1 else 0
  let f5 : ℤ := if c.a.testBit 13 then 5 else 1
  let es := eNs c.a
  KE.sum ((List.range es.length).map fun n =>
    .mul (.int f5) (.mul (.lin (es.getD n []))
      (.add (.mul (X0E z0 z1) (.lin (prj i (Yp (n + a0)))))
        (.mul (X1E z1) (.lin (prj i (Yp (n + a0 + 1))))))))
def s0E (c : WCert) : KE := .add (.int 1) (.mul (.lin (alP 1)) (.lin c.c0))
def rhsE (i : ℕ) (c : WCert) : KE :=
  .add (.mul (.lin (alP (2 * c.mh)))
      (.add (.add (.mul (.mul (s0E c) (s0E c)) (.lin (prj i (Yp (2 * c.ep)))))
        (.mul (.mul (.int 2) (.mul (s0E c) (.lin c.s1))) (.lin (prj i (Yp (2 * c.ep + 1))))))
        (.mul (.mul (.lin c.s1) (.lin c.s1)) (.lin (prj i (Yp (2 * c.ep + 2)))))))
    (.mul (.lin (alP (if i = 0 then c.n0 else c.n1))) (.lin (if i = 0 then c.R0 else c.R1)))
def z0L (s : ℕ) : List ℤ := (SUnitData.gL.getD s []).getD 0 []
def z1L (s : ℕ) : List ℤ := (SUnitData.gL.getD s []).getD 1 []
def certE (i s : ℕ) : KE := .sub (lhsE i (z0L s) (z1L s) (w3certL.getD s default)) (rhsE i (w3certL.getD s default))



